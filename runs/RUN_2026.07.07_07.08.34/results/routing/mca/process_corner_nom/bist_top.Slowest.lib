library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0278;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0014;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.01888,2.02804,2.05379,2.12029,2.32094,3.02904,5.58328");
	}
	rise_transition(template_1) {
          values("0.04089,0.04741,0.06833,0.13914,0.40694,1.40440,4.99937");
	}
	cell_fall(template_1) {
          values("2.07435,2.08119,2.10335,2.15928,2.31571,2.85136,4.78670");
	}
	fall_transition(template_1) {
          values("0.03451,0.03979,0.05713,0.10985,0.30122,1.02162,3.65108");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.74102,1.75126,1.77803,1.85031,2.07575,2.81587,5.28214");
	}
	rise_transition(template_1) {
          values("0.03064,0.03943,0.06673,0.15761,0.47292,1.52760,5.00176");
	}
	cell_fall(template_1) {
          values("1.87580,1.88571,1.90976,1.96340,2.09935,2.52075,3.91402");
	}
	fall_transition(template_1) {
          values("0.03262,0.03940,0.05710,0.10708,0.27045,0.84134,2.74494");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0031;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.76620");
	}
	fall_constraint(scalar) {
          values("-0.80786");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("4.37785");
	}
	fall_constraint(scalar) {
          values("3.10895");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.07998");
	}
	fall_constraint(scalar) {
          values("-0.00663");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("2.06960");
	}
	fall_constraint(scalar) {
          values("1.81186");
	}
      }
    }
  }

}
