library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0273;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.01574,2.01925,2.02823,2.05078,2.11617,2.33181,3.04362");
	}
	rise_transition(template_1) {
          values("0.01811,0.02051,0.02790,0.05298,0.14439,0.45863,1.50760");
	}
	cell_fall(template_1) {
          values("2.07384,2.07686,2.08483,2.10348,2.14902,2.28439,2.73227");
	}
	fall_transition(template_1) {
          values("0.01552,0.01773,0.02346,0.03909,0.08882,0.26577,0.86362");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.72665,1.73034,1.73969,1.76458,1.83824,2.06482,2.75720");
	}
	rise_transition(template_1) {
          values("0.01230,0.01572,0.02604,0.05946,0.16630,0.49675,1.51007");
	}
	cell_fall(template_1) {
          values("1.86421,1.86758,1.87555,1.89238,1.93063,2.03543,2.35469");
	}
	fall_transition(template_1) {
          values("0.01268,0.01509,0.02084,0.03523,0.07666,0.21252,0.63997");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.23537");
	}
	fall_constraint(scalar) {
          values("-0.29518");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.03969");
	}
	fall_constraint(scalar) {
          values("0.77959");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0031;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.03266");
	}
	fall_constraint(scalar) {
          values("0.02313");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.57382");
	}
	fall_constraint(scalar) {
          values("0.54110");
	}
      }
    }
  }

}
