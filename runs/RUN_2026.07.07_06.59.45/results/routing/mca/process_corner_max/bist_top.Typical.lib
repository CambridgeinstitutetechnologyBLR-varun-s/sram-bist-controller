library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0272;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.01467,2.01914,2.03072,2.05842,2.13162,2.35486,3.06532");
	}
	rise_transition(template_1) {
          values("0.02404,0.02726,0.03677,0.06564,0.16205,0.48199,1.50525");
	}
	cell_fall(template_1) {
          values("2.07280,2.07677,2.08717,2.11026,2.16423,2.31671,2.79707");
	}
	fall_transition(template_1) {
          values("0.02071,0.02322,0.03050,0.04990,0.10891,0.30674,0.94780");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.72606,1.73107,1.74310,1.77253,1.85304,2.08597,2.77484");
	}
	rise_transition(template_1) {
          values("0.01761,0.02198,0.03437,0.07140,0.18460,0.52105,1.50763");
	}
	cell_fall(template_1) {
          values("1.86355,1.86844,1.87872,1.89980,1.94512,2.06125,2.39567");
	}
	fall_transition(template_1) {
          values("0.01781,0.02057,0.02791,0.04571,0.09385,0.24217,0.69504");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.36432");
	}
	fall_constraint(scalar) {
          values("-0.46507");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.70026");
	}
	fall_constraint(scalar) {
          values("1.22688");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0031;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.08901");
	}
	fall_constraint(scalar) {
          values("0.00526");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.99842");
	}
	fall_constraint(scalar) {
          values("0.99215");
	}
      }
    }
  }

}
