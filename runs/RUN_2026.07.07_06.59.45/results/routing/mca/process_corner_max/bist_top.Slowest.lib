library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0272;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.01181,2.02094,2.04661,2.11305,2.31370,3.02166,5.57587");
	}
	rise_transition(template_1) {
          values("0.04059,0.04711,0.06806,0.13898,0.40694,1.40435,4.99944");
	}
	cell_fall(template_1) {
          values("2.07119,2.07808,2.10025,2.15618,2.31261,2.84829,4.78299");
	}
	fall_transition(template_1) {
          values("0.03450,0.03979,0.05711,0.10984,0.30121,1.02157,3.65044");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.72474,1.73500,1.76177,1.83406,2.05945,2.79939,5.26722");
	}
	rise_transition(template_1) {
          values("0.03060,0.03938,0.06671,0.15760,0.47290,1.52756,5.00155");
	}
	cell_fall(template_1) {
          values("1.86230,1.87220,1.89626,1.94988,2.08583,2.50719,3.90036");
	}
	fall_transition(template_1) {
          values("0.03261,0.03940,0.05709,0.10707,0.27043,0.84132,2.74478");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0027;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.73381");
	}
	fall_constraint(scalar) {
          values("-0.96462");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("3.65413");
	}
	fall_constraint(scalar) {
          values("2.57143");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0030;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.23919");
	}
	fall_constraint(scalar) {
          values("-0.13370");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("2.15494");
	}
	fall_constraint(scalar) {
          values("2.18410");
	}
      }
    }
  }

}
