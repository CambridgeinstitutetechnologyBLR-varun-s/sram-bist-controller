library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0244;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0013;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.92697,1.93603,1.96153,2.02785,2.22850,2.93620,5.49033");
	}
	rise_transition(template_1) {
          values("0.04000,0.04653,0.06751,0.13865,0.40693,1.40425,4.99959");
	}
	cell_fall(template_1) {
          values("1.99369,2.00070,2.02288,2.07883,2.23525,2.77097,4.70436");
	}
	fall_transition(template_1) {
          values("0.03448,0.03978,0.05709,0.10982,0.30119,1.02147,3.64912");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.66600,1.67628,1.70305,1.77534,2.00071,2.74054,5.20925");
	}
	rise_transition(template_1) {
          values("0.03057,0.03934,0.06669,0.15760,0.47288,1.52753,5.00143");
	}
	cell_fall(template_1) {
          values("1.80514,1.81505,1.83911,1.89272,2.02866,2.45001,3.84313");
	}
	fall_transition(template_1) {
          values("0.03261,0.03940,0.05709,0.10706,0.27043,0.84131,2.74469");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0025;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.73663");
	}
	fall_constraint(scalar) {
          values("-0.94881");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("3.57011");
	}
	fall_constraint(scalar) {
          values("2.49017");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0029;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.22403");
	}
	fall_constraint(scalar) {
          values("-0.13803");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("2.14219");
	}
	fall_constraint(scalar) {
          values("2.17882");
	}
      }
    }
  }

}
