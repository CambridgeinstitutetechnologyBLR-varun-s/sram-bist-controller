library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0245;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0013;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.93024,1.93370,1.94258,1.96502,2.03039,2.24595,2.95754");
	}
	rise_transition(template_1) {
          values("0.01770,0.02007,0.02749,0.05274,0.14435,0.45864,1.50726");
	}
	cell_fall(template_1) {
          values("1.99598,1.99899,2.00697,2.02563,2.07118,2.20655,2.65426");
	}
	fall_transition(template_1) {
          values("0.01549,0.01771,0.02341,0.03908,0.08880,0.26579,0.86365");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0008;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.66740,1.67107,1.68039,1.70527,1.77894,2.00554,2.69811");
	}
	rise_transition(template_1) {
          values("0.01216,0.01559,0.02595,0.05943,0.16631,0.49673,1.51006");
	}
	cell_fall(template_1) {
          values("1.80654,1.80991,1.81788,1.83471,1.87296,1.97775,2.29696");
	}
	fall_transition(template_1) {
          values("0.01268,0.01508,0.02085,0.03523,0.07666,0.21255,0.63947");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0028;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.23346");
	}
	fall_constraint(scalar) {
          values("-0.28798");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.00754");
	}
	fall_constraint(scalar) {
          values("0.75155");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0030;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02848");
	}
	fall_constraint(scalar) {
          values("0.01777");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.57237");
	}
	fall_constraint(scalar) {
          values("0.54361");
	}
      }
    }
  }

}
