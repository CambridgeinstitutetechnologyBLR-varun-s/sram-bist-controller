library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00181,  0.00654,  0.02365,  0.08552,  0.30928,  1.11848");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0258;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.12214,2.13151,2.15774,2.22460,2.42524,3.13416,5.68861");
	}
	rise_transition(template_1) {
          values("0.04268,0.04918,0.06998,0.14014,0.40696,1.40471,4.99894");
	}
	cell_fall(template_1) {
          values("2.15426,2.16120,2.18348,2.23960,2.39616,2.93160,4.86738");
	}
	fall_transition(template_1) {
          values("0.03519,0.04047,0.05770,0.11020,0.30130,1.02237,3.65082");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.76539,1.77565,1.80242,1.87470,2.10011,2.84010,5.30744");
	}
	rise_transition(template_1) {
          values("0.03061,0.03939,0.06671,0.15761,0.47291,1.52757,5.00161");
	}
	cell_fall(template_1) {
          values("1.90191,1.91182,1.93588,1.98950,2.12545,2.54682,3.94003");
	}
	fall_transition(template_1) {
          values("0.03262,0.03940,0.05709,0.10707,0.27044,0.84133,2.74483");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0033;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.87750");
	}
	fall_constraint(scalar) {
          values("-0.79863");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("3.51995");
	}
	fall_constraint(scalar) {
          values("2.45107");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0030;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.26894");
	}
	fall_constraint(scalar) {
          values("-0.15175");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("2.20572");
	}
	fall_constraint(scalar) {
          values("1.92240");
	}
      }
    }
  }

}
