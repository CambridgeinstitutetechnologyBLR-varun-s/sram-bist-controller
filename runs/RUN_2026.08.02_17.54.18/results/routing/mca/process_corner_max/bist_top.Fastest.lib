library (bist_top) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00166,  0.00553,  0.01838,  0.06111,  0.20321,  0.67567");
  }

  cell ("bist_top") {
    pin("clk") {
      direction : input;
      capacitance : 0.0259;
    }
    pin("done") {
      direction : output;
      capacitance : 0.0015;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("2.12606,2.12979,2.13929,2.16244,2.22798,2.44338,3.15583");
	}
	rise_transition(template_1) {
          values("0.01965,0.02227,0.02972,0.05418,0.14464,0.45858,1.50588");
	}
	cell_fall(template_1) {
          values("2.15696,2.15997,2.16793,2.18656,2.23206,2.36740,2.81587");
	}
	fall_transition(template_1) {
          values("0.01561,0.01780,0.02364,0.03913,0.08891,0.26571,0.86352");
	}
      }
    }
    pin("pass_fail") {
      direction : output;
      capacitance : 0.0009;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("1.76729,1.77100,1.78037,1.80526,1.87891,2.10548,2.79776");
	}
	rise_transition(template_1) {
          values("0.01238,0.01580,0.02609,0.05948,0.16629,0.49676,1.51008");
	}
	cell_fall(template_1) {
          values("1.90383,1.90720,1.91517,1.93200,1.97025,2.07505,2.39434");
	}
	fall_transition(template_1) {
          values("0.01268,0.01509,0.02084,0.03523,0.07666,0.21251,0.64022");
	}
      }
    }
    pin("rst_n") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.29306");
	}
	fall_constraint(scalar) {
          values("-0.25079");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.98254");
	}
	fall_constraint(scalar) {
          values("0.75530");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0031;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.04195");
	}
	fall_constraint(scalar) {
          values("0.01997");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.59115");
	}
	fall_constraint(scalar) {
          values("0.52003");
	}
      }
    }
  }

}
